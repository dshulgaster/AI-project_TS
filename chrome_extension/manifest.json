{
  "manifest_version": 3,
  "name": "TrackStudio CyberOS - П-Ф по запросу",
  "version": "7.6.0",
  "description": "Элегантный срез План-Факта v7.6: Микро-распределение каждой подзадачи по ее персональной дате создания.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.colvir.ru/*",
    "*://*/TrackStudio/*",
    "*://*/trackstudio/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.colvir.ru/*TrackStudio*",
        "*://*.colvir.ru/*trackstudio*",
        "*://*/TrackStudio/*",
        "*://*/trackstudio/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "allocator.js",
        "ag_grid_parser.js",
        "phase_calculator.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Открыть/Скрыть П-Ф по запросу"
  }
}
