# ==========================================
# TrackStudio (TS) Configuration
# ==========================================
TRACKSTUDIO_URL=https://ts.colvir.ru
TRACKSTUDIO_USER=your_login
TRACKSTUDIO_PASSWORD=your_password
TRACKSTUDIO_API_TOKEN=your_api_token_here

# ==========================================
# MS Project Server (MSP) Configuration
# ==========================================
MSP_SERVER_URL=https://msp.colvir.ru/PWA
MSP_USER=domain\your_login
MSP_PASSWORD=your_password
MSP_ODATA_ENDPOINT=https://msp.colvir.ru/PWA/_api/ProjectData

# ==========================================
# Dashboard & Export Settings
# ==========================================
DEFAULT_EXPORT_PATH=./data/ts_export.json
DASHBOARD_REFRESH_INTERVAL_MINUTES=60
